":"goodbye"},{"#f":5}]}],{"#f":1}],"firstmeeting":["ev",{"VAR?":"marie_firstmeeting"},"/ev",[{"->":".^.b","c":true},{"b":["\n","ev",false,"/ev",{"VAR=":"marie_firstmeeting","re":true},"^My, my, who do we have here?","\n","^You look capable enough, at least more capable than him.","\n","^Care to do me a favour?","\n","ev","str","^I don’t remember my name.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Sure, what’s the favour?","/str","/ev",{"*":".^.c-1","flg":4},{"->":".^.^.^.5"},{"c-0":["\n",{"->":"Rhetorical"},{"#f":5}],"c-1":["\n",{"->":"ASimpleFavour"},{"#f":5}]}]}],[{"->":".^.b"},{"b":["\n","^You had a change of heart?","\n",{"->":".^.^.^.5"},null]}],"nop","\n",{"#f":1}],"Rhetorical":[["^Oh... that first question was rhetorical dear, I do not care about something as mundane as a name.","\n","^All I care about is if you can do something for me. I promise it will be worth the effort.","\n","ev","str","^What’s the favour?","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["\n",{"->":"ASimpleFavour"},{"#f":5}]}],{"#f":1}],"ChangedMind":["^How... unfortunate...","\n","^Well, should you ever change your mind you know where to find me dear.","\n","end",{"#f":1}],"ASimpleFavour":[["^Well you see, I have been living in squalor for far too long.","\n","^Mr Baptiste simply refuses to put in the effort of securing and preparing one of my favourite dishes.","\n","^Instead, he opts to catch his own preferences. Thus, all I ask is that you catch me two flounders. Simple Really.","\n","^I trust I can count on you?","\n","ev","str","^Sure thing.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^I can't help right now.","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^I have some right here.","/str","str","^Item_Flounder","/str",2,{"x()":"HasItem","exArgs":2},"/ev",{"*":".^.c-2","flg":5},{"c-0":["\n","ev",{"VAR?":"CollectPondItemQuestId"},{"x()":"StartQuest","exArgs":1},"pop","/ev","\n",{"->":".^.^.^"},{"#f":5}],"c-1":["\n",{"->":"ChangedMind"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"CollectPondItemQuestId"},{"x()":"StartQuest","exArgs":1},"pop","/ev","\n","^Run along now, don’t keep me waiting","\n","^I’ll be back","\n","^Wait, Who are you?","\n","^Expanded Horizons:","\n","^I have another task for you. It should not be too hard for someone like you.","\n","^Someone like me?","\n","^What’s the task?","\n","^Why yes! You with your big arms and those trusty fishing doodads of yours.","\n","^I have not met anyone more capable of providing exactly what I am asking for?","\n","^What would that be?","\n","^Only two crabs and two crawfish. They’d be enough for a wonderful crab pot pie or crustacean stew! Don’t worry I’ll make it worth your while. I can add an extra stop closer to the sunken grove entrance after you’ve helped me out.","\n","^Thank you dear! I’ll be seeing you.","\n","^Accordian Disposal:","\n","^Since you’re in the area, I have another request for you","\n","end",{"#f":5}]}],{"#f":1}],"goodbye":["^until next time my friend.","\n","end",{"#f":1}],"global decl":["ev","str","^","/str",{"VAR=":"priest_name"},true,{"VAR=":"first_meeting"},"str","^CollectPondItemQuest","/str",{"VAR=":"CollectPondItemQuestId"},"str","^CAN_START","/str",{"VAR=":"CollectPondItemQuestState"},"str","^CollectLanternQuest","/str",{"VAR=":"CollectLanternQuestId"},"str","^CAN_START","/str",{"VAR=":"CollectLanternQuestState"},"str","^","/str",{"VAR=":"olivier_known"},"str","^","/str",{"VAR=":"marie_known"},true,{"VAR=":"marie_firstmeeting"},"str","^PaymentForARideQuest","/str",{"VAR=":"PaymentForARideQuestId"},"str","^CAN_START","/str",{"VAR=":"PaymentForARideQuestState"},"str","^ExpandedHorizonsQuest","/str",{"VAR=":"ExpandedHorizonsQuestId"},"str","^CAN_START","/str",{"VAR=":"ExpandedHorizonsQuestState"},"str","^AcordianDisposalQuest","/str",{"VAR=":"AcordianDisposalQuestId"},"str","^CAN_START","/str",{"VAR=":"AcordianDisposalQuestState"},"str","^AMealToDieForQuest","/str",{"VAR=":"AMealToDieForQuestId"},"str","^CAN_START","/str",{"VAR=":"AMealToDieForQuestState"},"st